        ds_list_add(locale_arr[0,0],410);
        ds_list_add(locale_arr[0,0],550);
        ds_list_add(locale_arr[0,0],610);
        ds_list_add(locale_arr[0,0],710);
        ds_list_add(locale_arr[0,0],810);
        ds_list_add(locale_arr[0,0],910);
    // Recode Endless
        locale_arr[0,1] = ds_list_create();
        ds_list_clear(locale_arr[0,1]);
        ds_list_copy(locale_arr[0,1],locale_arr[0,0]);
        ds_list_replace(locale_arr[0,1],0,10);
    // Copy That
        locale_arr[0,2] = locale_arr[0,1];
        locale_arr[1,0] = locale_arr[0,0];
        locale_arr[1,1] = -1;
        locale_arr[1,2] = -1;
        locale_arr[2,0] = locale_arr[0,0];
        locale_arr[2,1] = -1;
        locale_arr[2,2] = -1;
// Print
if argument0
{
    for (local.i=0; local.i<5; local.i+=1;)
    {
        for (local.j=0; local.j<zone_len_arr[local.i]; local.j+=1;)
        {
            for (local.k=0; local.k<ds_list_size(zone_arr[local.i,local.j]); local.k+=1;)
            {
                local.rm = ds_list_find_value(zone_arr[local.i,local.j],local.k);
                if local.rm == 0 || !room_exists(local.rm)
                { show_error("Key "+string(local.i)+" Zone "+string(local.j)+" Index "+string(local.k+1)+" does not exist!",false); }
            }
            if rare_zone_arr[local.i,local.j] != noone
            {
                for (local.k=0; local.k<ds_list_size(rare_zone_arr[local.i,local.j]); local.k+=1;)
                {
                    local.rm = ds_list_find_value(rare_zone_arr[local.i,local.j],local.k);
                    if local.rm == 0 || !room_exists(local.rm)
                    { show_error("Key "+string(local.i)+" Rare Zone "+string(local.j)+" Index "+string(local.k+1)+" does not exist!",false); }
                }
            }
        }
    }
}
// Room
zone_list = every_zone_list;
rare_zone_list = rare_zone_arr[0,0];
rm_list = ds_list_create();
zone_reset_scr();
global.zone_key_var = -1; // Every
global.zone_var = 0;
// Draw
draw_load_scr("Loaded zones!");