/*
Argument 0: Room Variable (same for all rooms)
*/
room_set_code
(
    argument0,'
    // Name
    ini_open("lang_"+global.lang_var+".ini");
    global.rm_name_var = ini_read_string("ROOM","mad","ROOM_mad")+" 1"
    ini_close();
    // Spawns
    global.spawn_len_var = 5;
    global.spawn_arr[0,0] = 464;
    global.spawn_arr[0,1] = 352;
    global.spawn_arr[0,2] = 0;
    global.spawn_arr[0,3] = 0;
    global.spawn_arr[1,0] = 688;
    global.spawn_arr[1,1] = 176;
    global.spawn_arr[1,2] = 0;
    global.spawn_arr[1,3] = 180;
    global.spawn_arr[2,0] = 688;
    global.spawn_arr[2,1] = 240;
    global.spawn_arr[2,2] = 0;
    global.spawn_arr[2,3] = 0;
    global.spawn_arr[3,0] = 688;
    global.spawn_arr[3,1] = 528;
    global.spawn_arr[3,2] = 0;
    global.spawn_arr[3,3] = 180;
    global.spawn_arr[4,0] = 944;
    global.spawn_arr[4,1] = 352;
    global.spawn_arr[4,2] = 0;
    global.spawn_arr[4,3] = 180;
    // Mark
    global.mark_len_var = 1;
    mark_arr[0,0] = 656;
    mark_arr[0,1] = 352;
    mark_arr[0,2] = 0;
    // 3D Draw
    d3d_start();
    global.draw_3d_var = true;
    // Doors
    spawn_create_scr(true,false,false,mad_door_obj,spawn_door_trig_obj);
');
